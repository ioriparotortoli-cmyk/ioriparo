# ─────────────────────────────────────────────────────────────
#  Io Riparo — configurazione del sito
#  Copia questo file in `.env` e completa i valori.
# ─────────────────────────────────────────────────────────────

# ── Invio dei moduli ────────────────────────────────────────────────────────
# Vale per Contatti, Preventivo, Prenotazione e Newsletter.
#
# Il modulo Formspree di Io Riparo è già impostato nel codice
# (src/sito/lib/moduli.ts): il sito funziona senza toccare nulla qui.
#
# Questa variabile serve solo per puntare a un modulo diverso, per esempio
# per fare prove senza riempire la casella vera.
#
# La conferma "inviato" compare SOLO dopo una risposta positiva del servizio;
# in caso contrario il visitatore vede il motivo dell'errore e i recapiti
# alternativi.
#
# Funzionano anche Web3Forms, Getform e Basin: stessa variabile, e per i
# servizi che richiedono una chiave si valorizza VITE_MODULI_CHIAVE.
VITE_MODULI_ENDPOINT=
VITE_MODULI_CHIAVE=

# Navigazione con fragment (#/servizi) per gli hosting statici che non
# riscrivono gli URL. Lasciare vuoto per gli URL normali.
VITE_ROUTER=

# ── Archivio online (Supabase) ──────────────────────────────────────────────
# Il gestionale e il sito condividono lo stesso archivio: le riparazioni
# aperte in laboratorio diventano lo stato che il cliente legge alla pagina
# «Stato riparazione», e le richieste dei moduli arrivano in «Richieste dal
# sito» oltre che per e-mail.
#
# Dove si trovano: pannello Supabase → Project Settings → API.
#   VITE_SUPABASE_URL       = "Project URL"
#   VITE_SUPABASE_ANON_KEY  = chiave "anon public"
#
# Queste due variabili NON sono un segreto: finiscono nel codice di qualunque
# sito che usi Supabase e da sole non aprono niente, perché i permessi li
# decide il database (supabase/schema.sql). La chiave "service_role", invece,
# è segreta e non va mai messa qui né in nessun file del progetto.
#
# Lasciandole vuote il gestionale continua a lavorare sull'archivio locale del
# browser e il sito funziona ugualmente.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Includi il gestionale (/gestionale) nella build. LASCIARE VUOTO per il sito
# pubblico finché l'archivio online non è configurato: senza Supabase il
# gestionale non ha accesso protetto e mostrerebbe i dati a chiunque.
# Con VITE_SUPABASE_URL e VITE_SUPABASE_ANON_KEY impostate, l'ingresso è
# protetto da e-mail e password e si può mettere a 1 anche in produzione.
VITE_GESTIONALE=
