# ─────────────────────────────────────────────────────────────
#  Io Riparo — configurazione del sito
#  Copia questo file in `.env` e completa i valori.
# ─────────────────────────────────────────────────────────────

# ── Invio dei moduli ────────────────────────────────────────────────────────
# Vale per Contatti, Preventivo, Prenotazione e Newsletter.
#
# Incolla qui l'endpoint del tuo modulo Formspree, nella forma
#   https://formspree.io/f/xxxxxxxx
# L'ID è quello che Formspree mostra nella pagina del modulo (Integration →
# "Your form's endpoint"). Il modulo va impostato per recapitare a
# ioriparotortoli@gmail.com.
#
# Con l'endpoint configurato la conferma "inviato" compare SOLO dopo una
# risposta positiva di Formspree; in caso contrario il visitatore vede il
# motivo dell'errore e i recapiti alternativi.
#
# Se resta vuoto i moduli ripiegano sul programma di posta del visitatore,
# già compilato verso ioriparotortoli@gmail.com.
#
# Funzionano anche Web3Forms, Getform e Basin: stessa variabile, e per i
# servizi che richiedono una chiave si valorizza VITE_MODULI_CHIAVE.
VITE_MODULI_ENDPOINT=
VITE_MODULI_CHIAVE=

# Navigazione con fragment (#/servizi) per gli hosting statici che non
# riscrivono gli URL. Lasciare vuoto per gli URL normali.
VITE_ROUTER=

# Includi il gestionale (/gestionale) nella build. LASCIARE VUOTO per il sito
# pubblico: il gestionale non ha autenticazione e non va esposto in rete.
# Vale solo per compilazioni destinate all'uso interno.
VITE_GESTIONALE=
