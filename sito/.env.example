# ---------------------------------------------------------------------------
# Io Riparo — variabili d'ambiente
# Copia questo file in `.env.local` e compila i valori.
# Il sito funziona anche senza nessuna di queste variabili: in quel caso usa i
# contenuti statici e i moduli rispondono in modalità dimostrativa.
# ---------------------------------------------------------------------------

# Dominio pubblico (serve a canonical, sitemap, Open Graph e dati strutturati)
NEXT_PUBLIC_SITE_URL=https://www.ioriparo.it

# Contatti mostrati nel sito -------------------------------------------------
# Numero in formato internazionale, senza spazi. È usato per "Chiama Ora",
# per il pulsante WhatsApp e per i dati strutturati LocalBusiness.
NEXT_PUBLIC_TELEFONO=+393500000000
NEXT_PUBLIC_WHATSAPP=+393500000000
NEXT_PUBLIC_EMAIL=info@ioriparo.it
NEXT_PUBLIC_PARTITA_IVA=00000000000

# Profili social e scheda Google (facoltativi)
NEXT_PUBLIC_FACEBOOK=https://www.facebook.com/ioriparo
NEXT_PUBLIC_INSTAGRAM=https://www.instagram.com/ioriparo
NEXT_PUBLIC_GOOGLE_PROFILO=https://g.page/ioriparo
NEXT_PUBLIC_GOOGLE_RECENSIONI=https://g.page/r/ioriparo/review

# Supabase -------------------------------------------------------------------
# Project Settings → API. La service role key resta solo lato server.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=media

# Notifiche email (Resend) ---------------------------------------------------
RESEND_API_KEY=
EMAIL_MITTENTE=Io Riparo <noreply@ioriparo.it>
EMAIL_DESTINATARIO=info@ioriparo.it

# Recensioni Google (Places API New) -----------------------------------------
# Con entrambe le variabili il sito importa automaticamente le recensioni reali.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
